---
interface Props {
  title?: string;
  description?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  title = '¿Listo para prender el cerebro?',
  description = 'Explora artículos claros, gratuitos y hechos para compartirse. Aprender es gratis. Compartir también.',
  primaryHref = '/articulos/',
  primaryLabel = 'Explorar conocimiento',
  secondaryHref = '/sobre/',
  secondaryLabel = 'Conoce el proyecto',
} = Astro.props;
---

<section class="cta-band">
  <div class="container cta-band__inner">
    <div>
      <p class="eyebrow" style="color: #f5d56d;">Comunidad abierta</p>
      <h2>{title}</h2>
      <p>{description}</p>
    </div>
    <div class="btn-group">
      <a class="btn btn--primary" href={primaryHref}>{primaryLabel}</a>
      <a class="btn btn--secondary cta-band__secondary" href={secondaryHref}>{secondaryLabel}</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding: clamp(3rem, 6vw, 4.5rem) 0;
  }

  .cta-band__inner {
    display: grid;
    gap: 1.75rem;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border-radius: calc(var(--radius-xl) + 4px);
    background: var(--gradient-cta);
    color: white;
    box-shadow: var(--shadow-lg);
    position: relative;
    overflow: hidden;
  }

  .cta-band__inner::before {
    content: '';
    position: absolute;
    width: 16rem;
    height: 16rem;
    right: -4rem;
    top: -6rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(230, 168, 0, 0.35), transparent 70%);
    pointer-events: none;
  }

  .cta-band h2 {
    margin-top: 0.55rem;
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    color: white;
    max-width: 14ch;
  }

  .cta-band p {
    margin-top: 0.75rem;
    max-width: 36rem;
    color: rgba(255, 255, 255, 0.82);
  }

  .cta-band__secondary {
    --btn-color: white;
    --btn-border: rgba(255, 255, 255, 0.28);
    --btn-hover: rgba(255, 255, 255, 0.08);
  }

  @media (min-width: 860px) {
    .cta-band__inner {
      grid-template-columns: 1.4fr auto;
      align-items: end;
    }
  }
</style>
