---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 2 && (
    <nav class="toc" aria-label="Tabla de contenidos">
      <p class="toc__title">En este artículo</p>
      <ol class="toc__list">
        {items.map((heading) => (
          <li class={`toc__item toc__item--h${heading.depth}`}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc {
    padding: 1.15rem 1.2rem;
    border-radius: var(--radius-lg);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-xs);
  }

  .toc__title {
    font-size: var(--text-xs);
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin-bottom: 0.85rem;
  }

  .toc__list {
    list-style: none;
    display: grid;
    gap: 0.45rem;
  }

  .toc__item a {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    text-decoration: none;
    line-height: 1.4;
    padding: 0.2rem 0;
    border-left: 2px solid transparent;
    padding-left: 0.75rem;
    transition:
      color var(--duration-fast) var(--ease-soft),
      border-color var(--duration-fast) var(--ease-soft);
  }

  .toc__item--h3 a {
    padding-left: 1.35rem;
    font-size: 0.84rem;
  }

  .toc__item a:hover {
    color: var(--color-blue);
    border-left-color: var(--color-yellow);
  }
</style>
