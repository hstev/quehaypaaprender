---
import Logo from './Logo.astro';
---

<section class="hero">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__content reveal">
      <div class="hero__brand">
        <Logo size="lg" withWordmark={false} />
        <p class="eyebrow">Plataforma educativa abierta</p>
      </div>

      <h1 class="hero__title">Que hay pa' aprender?</h1>
      <p class="hero__subtitle">
        Conocimiento para todos. Gratis, abierto y sin humo.
      </p>

      <div class="btn-group hero__actions">
        <a class="btn btn--primary" href="/articulos/">
          Explorar conocimiento
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M5 12h14M13 6l6 6-6 6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
        <a class="btn btn--secondary" href="/categorias/">Ver categorías</a>
      </div>

      <ul class="hero__signals">
        <li>
          <span class="hero__dot hero__dot--yellow"></span>
          Artículos cortos y claros
        </li>
        <li>
          <span class="hero__dot hero__dot--blue"></span>
          100% gratuito
        </li>
        <li>
          <span class="hero__dot hero__dot--red"></span>
          Sin ánimo de lucro
        </li>
      </ul>
    </div>

    <div class="hero__visual reveal" aria-hidden="true">
      <div class="hero__stage">
        <div class="hero__ring"></div>
        <div class="hero__card hero__card--main">
          <Logo size="xl" withWordmark={false} />
          <p class="hero__card-kicker">Prende el cerebro</p>
          <p class="hero__card-line">Apaga la ignorancia.</p>
        </div>

        <div class="hero__float hero__float--1">
          <span>API</span>
          <small>Fundamentos</small>
        </div>
        <div class="hero__float hero__float--2">
          <span>Arepa</span>
          <small>Cocina</small>
        </div>
        <div class="hero__float hero__float--3">
          <span>K8s</span>
          <small>Cloud</small>
        </div>
        <div class="hero__float hero__float--4">
          <span>IA</span>
          <small>Ciencia</small>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(3.5rem, 8vw, 6rem);
    background: var(--gradient-hero);
    overflow: hidden;
  }

  .hero__glow {
    position: absolute;
    inset: auto -10% -20% 40%;
    height: 55%;
    background: radial-gradient(circle, rgba(230, 168, 0, 0.12), transparent 70%);
    pointer-events: none;
    z-index: -1;
  }

  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  .hero__brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
  }

  .hero__title {
    font-family: var(--font-serif);
    font-size: var(--text-5xl);
    font-weight: 550;
    letter-spacing: -0.045em;
    line-height: 0.98;
    max-width: 11ch;
  }

  .hero__subtitle {
    margin-top: 1.25rem;
    max-width: 28rem;
    font-size: var(--text-lg);
    color: var(--color-ink-soft);
    line-height: 1.55;
  }

  .hero__actions {
    margin-top: 1.75rem;
  }

  .hero__signals {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: 2rem;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    font-weight: 600;
  }

  .hero__signals li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hero__dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
  }

  .hero__dot--yellow {
    background: var(--color-yellow);
  }
  .hero__dot--blue {
    background: var(--color-blue);
  }
  .hero__dot--red {
    background: var(--color-red);
  }

  .hero__visual {
    display: flex;
    justify-content: center;
  }

  .hero__stage {
    position: relative;
    width: min(100%, 26rem);
    aspect-ratio: 1 / 1.05;
    display: grid;
    place-items: center;
  }

  .hero__ring {
    position: absolute;
    inset: 8%;
    border-radius: 50%;
    border: 1px dashed rgba(27, 79, 138, 0.2);
    animation: float-soft 7s ease-in-out infinite;
  }

  .hero__card--main {
    position: relative;
    z-index: 2;
    width: min(100%, 17.5rem);
    padding: 2rem 1.5rem 1.75rem;
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-lg);
    text-align: center;
    backdrop-filter: blur(8px);
  }

  .hero__card--main :global(.logo) {
    justify-content: center;
    margin-bottom: 1rem;
  }

  .hero__card-kicker {
    font-size: var(--text-sm);
    font-weight: 750;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-blue);
  }

  .hero__card-line {
    margin-top: 0.35rem;
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-ink);
  }

  .hero__float {
    position: absolute;
    z-index: 3;
    display: grid;
    gap: 0.1rem;
    padding: 0.7rem 0.9rem;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
    animation: float-soft 5.5s ease-in-out infinite;
  }

  .hero__float span {
    font-weight: 750;
    font-size: 0.92rem;
    letter-spacing: -0.02em;
  }

  .hero__float small {
    color: var(--color-ink-muted);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .hero__float--1 {
    top: 12%;
    left: 0;
    animation-delay: 0.2s;
  }

  .hero__float--2 {
    top: 18%;
    right: 0;
    animation-delay: 0.8s;
  }

  .hero__float--3 {
    bottom: 18%;
    left: 2%;
    animation-delay: 1.1s;
  }

  .hero__float--4 {
    bottom: 12%;
    right: 4%;
    animation-delay: 0.4s;
  }

  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 2rem;
    }

    .hero__title {
      max-width: 12ch;
    }
  }

  @media (max-width: 420px) {
    .hero__float {
      padding: 0.55rem 0.7rem;
    }
  }
</style>
