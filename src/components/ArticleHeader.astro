---
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';
import { getCategoryByName } from '../lib/categories';
import { formatDate, readingTimeLabel } from '../lib/utils';
import { getArticleReadingTime, getCategoryHref } from '../lib/articles';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const category = getCategoryByName(article.data.category);
const minutes = getArticleReadingTime(article.body);
---

<header class="article-header">
  <a
    class={`article-header__category article-header__category--${category.accent}`}
    href={getCategoryHref(article.data.category)}
  >
    {article.data.category}
  </a>

  <h1>{article.data.title}</h1>
  <p class="article-header__desc">{article.data.description}</p>

  <div class="article-header__meta">
    <div class="article-header__author">
      <span class="article-header__avatar" aria-hidden="true"
        >{article.data.author.slice(0, 1)}</span
      >
      <div>
        <p class="article-header__name">{article.data.author}</p>
        <p class="article-header__sub">
          <time datetime={article.data.publishedAt.toISOString()}
            >{formatDate(article.data.publishedAt)}</time
          >
          <span aria-hidden="true">·</span>
          <span>{readingTimeLabel(minutes)}</span>
        </p>
      </div>
    </div>

    <div class="article-header__tags">
      {article.data.tags.map((tag) => <Tag label={tag} tone="neutral" />)}
    </div>
  </div>
</header>

<style>
  .article-header {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .article-header__category {
    display: inline-flex;
    margin-bottom: 1rem;
    font-size: var(--text-xs);
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .article-header__category--yellow {
    color: #8a6200;
  }
  .article-header__category--blue {
    color: var(--color-blue);
  }
  .article-header__category--red {
    color: var(--color-red);
  }
  .article-header__category--neutral {
    color: var(--color-ink-soft);
  }

  .article-header h1 {
    font-family: var(--font-serif);
    font-size: var(--text-4xl);
    font-weight: 550;
    letter-spacing: -0.04em;
    max-width: 18ch;
  }

  .article-header__desc {
    margin-top: 1rem;
    max-width: 42rem;
    font-size: var(--text-lg);
    color: var(--color-ink-soft);
    line-height: 1.55;
  }

  .article-header__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .article-header__author {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .article-header__avatar {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--color-blue);
    color: white;
    font-weight: 750;
  }

  .article-header__name {
    font-weight: 700;
    font-size: var(--text-sm);
  }

  .article-header__sub {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
    margin-top: 0.15rem;
  }

  .article-header__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
</style>
