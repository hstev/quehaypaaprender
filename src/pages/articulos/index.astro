---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Search from '../../components/Search.astro';
import { getPublishedArticles, getUsedCategories, getAllTags, getArticleHref, getArticleReadingTime } from '../../lib/articles';
import { formatShortDate, readingTimeLabel } from '../../lib/utils';
import { getCategoryByName } from '../../lib/categories';

const articles = await getPublishedArticles();
const categories = await getUsedCategories();
const tags = (await getAllTags()).slice(0, 12);

const catalog = articles.map((article, index) => ({
  id: article.id,
  title: article.data.title,
  description: article.data.description,
  category: article.data.category,
  categorySlug: getCategoryByName(article.data.category).slug,
  categoryAccent: getCategoryByName(article.data.category).accent,
  tags: article.data.tags,
  href: getArticleHref(article),
  readingTime: readingTimeLabel(getArticleReadingTime(article.body)),
  date: formatShortDate(article.data.publishedAt),
  datetime: article.data.publishedAt.toISOString(),
  accent: (['yellow', 'blue', 'red'] as const)[index % 3],
}));
---

<BaseLayout
  title="Explorar conocimiento"
  description="Busca y filtra artículos educativos por categoría y tags. Conocimiento claro, gratuito y abierto."
>
  <section class="explore">
    <div class="container">
      <header class="explore__header">
        <p class="eyebrow">Biblioteca abierta</p>
        <h1>Explorar conocimiento</h1>
        <p>
          Artículos cortos para entender un concepto y seguir. Filtra por categoría, busca por
          tags o escribe lo que te da curiosidad.
        </p>
      </header>

      <Search mode="inline" placeholder="Buscar por título, descripción, categoría o tags…" />

      <div class="explore__filters" data-explore-filters>
        <div class="explore__filter-group">
          <p class="explore__label">Categorías</p>
          <div class="explore__chips" role="list">
            <button class="chip is-active" type="button" data-filter-category="" role="listitem">
              Todas
            </button>
            {
              categories.map((category) => (
                <button
                  class="chip"
                  type="button"
                  data-filter-category={category.slug}
                  role="listitem"
                >
                  {category.name}
                </button>
              ))
            }
          </div>
        </div>

        <div class="explore__filter-group">
          <p class="explore__label">Tags populares</p>
          <div class="explore__chips" role="list">
            {
              tags.map(({ tag }) => (
                <button class="chip chip--soft" type="button" data-filter-tag={tag} role="listitem">
                  #{tag}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <div class="explore__count">
        <p data-explore-count></p>
        <button class="explore__clear" type="button" data-explore-clear hidden>
          Limpiar filtros
        </button>
      </div>

      <div class="grid-articles" data-explore-grid></div>
      <div data-explore-empty hidden></div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ catalog }}>
  const grid = document.querySelector('[data-explore-grid]');
  const empty = document.querySelector('[data-explore-empty]');
  const countEl = document.querySelector('[data-explore-count]');
  const clearBtn = document.querySelector('[data-explore-clear]');
  const params = new URLSearchParams(window.location.search);

  let activeCategory = params.get('categoria') ?? '';
  let activeTag = params.get('tag') ?? '';

  function syncChips() {
    document.querySelectorAll('[data-filter-category]').forEach((btn) => {
      btn.classList.toggle('is-active', btn.getAttribute('data-filter-category') === activeCategory);
    });
    document.querySelectorAll('[data-filter-tag]').forEach((btn) => {
      const tag = btn.getAttribute('data-filter-tag') ?? '';
      btn.classList.toggle('is-active', tag.toLowerCase() === activeTag.toLowerCase());
    });
  }

  function updateUrl() {
    const next = new URL(window.location.href);
    if (activeCategory) next.searchParams.set('categoria', activeCategory);
    else next.searchParams.delete('categoria');
    if (activeTag) next.searchParams.set('tag', activeTag);
    else next.searchParams.delete('tag');
    history.replaceState({}, '', next);
  }

  function filtered() {
    return catalog.filter((article) => {
      const catOk = !activeCategory || article.categorySlug === activeCategory;
      const tagOk =
        !activeTag || article.tags.some((t) => t.toLowerCase() === activeTag.toLowerCase());
      return catOk && tagOk;
    });
  }

  function render() {
    const items = filtered();
    syncChips();
    updateUrl();

    if (countEl) {
      const label = items.length === 1 ? 'artículo' : 'artículos';
      let text = `${items.length} ${label}`;
      if (activeCategory) {
        const catBtn = document.querySelector(`[data-filter-category="${activeCategory}"]`);
        text += ` en ${catBtn?.textContent?.trim() ?? activeCategory}`;
      }
      if (activeTag) text += ` con tag #${activeTag}`;
      countEl.textContent = text;
    }

    if (clearBtn) clearBtn.hidden = !(activeCategory || activeTag);

    if (!items.length) {
      if (grid) grid.innerHTML = '';
      if (empty) {
        empty.hidden = false;
        empty.innerHTML = `
          <div class="empty-inline">
            <h3>No encontramos artículos</h3>
            <p>Prueba otra categoría, otro tag o limpia los filtros.</p>
          </div>`;
      }
      return;
    }

    if (empty) empty.hidden = true;
    if (!grid) return;

    grid.innerHTML = items
      .map(
        (article) => `
      <article class="article-card article-card--default article-card--${article.accent}">
        <a class="article-card__link" href="${article.href}">
          <div class="article-card__visual" aria-hidden="true">
            <div class="article-card__orb"></div>
            <div class="article-card__pattern"></div>
            <span class="article-card__glyph">✦</span>
          </div>
          <div class="article-card__body">
            <div class="article-card__meta">
              <span class="article-card__category article-card__category--${article.categoryAccent}">${article.category}</span>
              <span>${article.readingTime}</span>
            </div>
            <h3 class="article-card__title">${article.title}</h3>
            <p class="article-card__desc">${article.description}</p>
            <div class="article-card__footer">
              <div class="article-card__tags">
                ${article.tags
                  .slice(0, 3)
                  .map((tag) => `<span class="tag tag--neutral tag--sm">${tag}</span>`)
                  .join('')}
              </div>
              <time datetime="${article.datetime}">${article.date}</time>
            </div>
          </div>
        </a>
      </article>`,
      )
      .join('');
  }

  document.querySelectorAll('[data-filter-category]').forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = btn.getAttribute('data-filter-category') ?? '';
      render();
    });
  });

  document.querySelectorAll('[data-filter-tag]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.getAttribute('data-filter-tag') ?? '';
      activeTag = activeTag.toLowerCase() === tag.toLowerCase() ? '' : tag;
      render();
    });
  });

  clearBtn?.addEventListener('click', () => {
    activeCategory = '';
    activeTag = '';
    render();
  });

  render();
</script>

<style>
  .explore {
    padding: clamp(2rem, 4vw, 3.5rem) 0 clamp(3rem, 6vw, 5rem);
  }

  .explore__header {
    max-width: 42rem;
    margin-bottom: 1.75rem;
  }

  .explore__header h1 {
    font-family: var(--font-serif);
    font-size: var(--text-4xl);
    font-weight: 550;
    letter-spacing: -0.04em;
    margin-top: 0.5rem;
  }

  .explore__header p:last-child {
    margin-top: 0.85rem;
    color: var(--color-ink-soft);
    font-size: var(--text-lg);
  }

  .explore__filters {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.75rem;
  }

  .explore__label {
    font-size: var(--text-xs);
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin-bottom: 0.65rem;
  }

  .explore__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg-elevated);
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
    font-weight: 650;
    cursor: pointer;
    transition:
      background var(--duration-fast) var(--ease-soft),
      border-color var(--duration-fast) var(--ease-soft),
      color var(--duration-fast) var(--ease-soft),
      transform var(--duration-fast) var(--ease-out);
  }

  .chip:hover,
  .chip.is-active {
    transform: translateY(-1px);
    color: var(--color-ink);
    border-color: rgba(27, 79, 138, 0.28);
    background: var(--color-blue-soft);
  }

  .chip.is-active {
    background: var(--color-blue);
    color: white;
    border-color: var(--color-blue);
  }

  .chip--soft.is-active {
    background: var(--color-yellow);
    border-color: var(--color-yellow);
    color: var(--color-accent-text);
  }

  .explore__count {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 1.75rem 0 1.25rem;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .explore__clear {
    border: 0;
    background: transparent;
    font-weight: 700;
    color: var(--color-blue);
    cursor: pointer;
    padding: 0;
  }

  .empty-inline {
    text-align: center;
    padding: 3rem 1rem;
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-xl);
    background: var(--color-bg-elevated);
  }

  .empty-inline h3 {
    font-size: var(--text-xl);
  }

  .empty-inline p {
    margin-top: 0.5rem;
    color: var(--color-ink-muted);
  }

  /* Mirror card styles for client-rendered cards */
  :global(.article-card) {
    position: relative;
    height: 100%;
    border-radius: var(--radius-xl);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition:
      transform var(--duration) var(--ease-out),
      box-shadow var(--duration) var(--ease-out),
      border-color var(--duration) var(--ease-soft);
  }

  :global(.article-card:hover) {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: rgba(27, 79, 138, 0.16);
  }

  :global(.article-card__link) {
    display: grid;
    height: 100%;
    text-decoration: none;
    color: inherit;
    grid-template-rows: auto 1fr;
  }

  :global(.article-card__visual) {
    position: relative;
    min-height: 7.5rem;
    overflow: hidden;
    background: var(--color-bg-soft);
  }

  :global(.article-card--yellow .article-card__visual) {
    background: linear-gradient(145deg, #fff7e0, #f3f6fb 60%);
  }

  :global(.article-card--blue .article-card__visual) {
    background: linear-gradient(145deg, #eaf2fb, #f7f8fa 62%);
  }

  :global(.article-card--red .article-card__visual) {
    background: linear-gradient(145deg, #f9ecec, #f7f8fa 62%);
  }

  :global(.article-card__orb) {
    position: absolute;
    width: 9rem;
    height: 9rem;
    border-radius: 50%;
    right: -2rem;
    top: -3rem;
    opacity: 0.55;
    background: radial-gradient(circle, rgba(230, 168, 0, 0.45), transparent 68%);
  }

  :global(.article-card--blue .article-card__orb) {
    background: radial-gradient(circle, rgba(27, 79, 138, 0.35), transparent 68%);
  }

  :global(.article-card--red .article-card__orb) {
    background: radial-gradient(circle, rgba(194, 58, 58, 0.3), transparent 68%);
  }

  :global(.article-card__pattern) {
    position: absolute;
    inset: 0;
    opacity: 0.35;
    background-image: radial-gradient(rgba(18, 24, 38, 0.08) 1px, transparent 1px);
    background-size: 12px 12px;
  }

  :global(.article-card__glyph) {
    position: absolute;
    left: 1.15rem;
    bottom: 1.1rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.82);
    border: 1px solid var(--color-border);
    color: var(--color-blue);
    box-shadow: var(--shadow-xs);
  }

  :global(.article-card__body) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.2rem 1.2rem 1.3rem;
  }

  :global(.article-card__meta) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.85rem;
    align-items: center;
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    font-weight: 600;
  }

  :global(.article-card__category) {
    font-weight: 750;
  }

  :global(.article-card__category--yellow) {
    color: #8a6200;
  }
  :global(.article-card__category--blue) {
    color: var(--color-blue);
  }
  :global(.article-card__category--red) {
    color: var(--color-red);
  }
  :global(.article-card__category--neutral) {
    color: var(--color-ink-soft);
  }

  :global(.article-card__title) {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 550;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  :global(.article-card__desc) {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.article-card__footer) {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.35rem;
  }

  :global(.article-card__tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  :global(.article-card__footer time) {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  :global(.tag) {
    display: inline-flex;
    padding: 0.28rem 0.65rem;
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: 650;
    background: var(--color-bg-muted);
    color: var(--color-ink-soft);
    border: 1px solid var(--color-border);
  }
</style>
