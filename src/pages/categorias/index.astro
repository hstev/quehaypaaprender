---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import { CATEGORIES } from '../../lib/categories';
import { getUsedCategories } from '../../lib/articles';

const used = await getUsedCategories();
const usedMap = new Map(used.map((c) => [c.slug, c.count]));

const categories = CATEGORIES.map((category) => ({
  ...category,
  count: usedMap.get(category.slug) ?? 0,
}));
---

<BaseLayout
  title="Categorías"
  description="Explora conocimiento por categorías: tecnología, programación, cocina, ciencia, diseño y más."
>
  <section class="categories-page">
    <div class="container">
      <header class="categories-page__header">
        <p class="eyebrow">Mapa de conocimiento</p>
        <h1>Categorías</h1>
        <p>
          Cada categoría agrupa artículos por temática. Agregar una nueva es tan simple como
          usar su nombre en el frontmatter de un Markdown.
        </p>
      </header>

      <div class="grid-categories grid-categories--dense">
        {
          categories.map((category, index) => (
            <CategoryCard category={category} index={index} />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .categories-page {
    padding: clamp(2rem, 4vw, 3.5rem) 0 clamp(3rem, 6vw, 5rem);
  }

  .categories-page__header {
    max-width: 40rem;
    margin-bottom: 2.25rem;
  }

  .categories-page__header h1 {
    font-family: var(--font-serif);
    font-size: var(--text-4xl);
    font-weight: 550;
    letter-spacing: -0.04em;
    margin-top: 0.5rem;
  }

  .categories-page__header p:last-child {
    margin-top: 0.85rem;
    color: var(--color-ink-soft);
    font-size: var(--text-lg);
  }
</style>
