---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';
import { absoluteUrl } from '../lib/utils';
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource-variable/newsreader';
import '../styles/global.css';
import '../styles/prose.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  author?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'Plataforma educativa sin ánimo de lucro para compartir conocimiento claro, visual y accesible.',
  image = '/og-default.svg',
  canonical,
  type = 'website',
  publishedTime,
  author,
  jsonLd,
} = Astro.props;

const siteName = "Que hay pa' aprender?";
const pageTitle = title === siteName ? title : `${title} · ${siteName}`;
const canonicalURL = canonical
  ? absoluteUrl(canonical)
  : new URL(Astro.url.pathname, Astro.site).toString();
const imageURL = image.startsWith('http') ? image : absoluteUrl(image);

const structured = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [
      {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteName,
        url: Astro.site?.toString(),
        description,
        inLanguage: 'es-CO',
      },
    ];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <meta name="theme-color" content="#1B4F8A" />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:locale" content="es_CO" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {author && <meta property="article:author" content={author} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    {
      structured.map((item) => (
        <script type="application/ld+json" set:html={JSON.stringify(item)} />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <Search mode="overlay" />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
  }
</style>
